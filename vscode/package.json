{
  "name": "align_symbols_vscode",
  "displayName": "Symbol Align (by column)",
  "description": "Align assignment symbols (=, +, <<, |=, [, ], ;) by column for chained bitfield assignments and member[sub]=value tables.",
  "version": "0.9.0",
  "publisher": "PandaShitsuke",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PandaShitsuke/AlignSymbols.git"
  },
  "bugs": {
    "url": "https://github.com/PandaShitsuke/AlignSymbols/issues"
  },
  "keywords": [
    "align",
    "alignment",
    "formatter",
    "bitfield",
    "column"
  ],
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Formatters", "Other"],
  "main": "./extension.js",
  "activationEvents": ["onCommand:alignSymbols.align"],
  "contributes": {
    "commands": [
      {
        "command": "alignSymbols.align",
        "title": "Align Symbols (by column)",
        "category": "Symbol Align"
      }
    ],
    "keybindings": [
      {
        "command": "alignSymbols.align",
        "key": "ctrl+alt+a",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "alignSymbols.align",
          "group": "1_modification@50",
          "when": "editorTextFocus"
        }
      ]
    }
  }
}
